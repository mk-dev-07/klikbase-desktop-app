{
	"name": "klikbase-time-tracker",
	"version": "1.1.4",
	"main": "index.js",
	"scripts": {
		"start": "electron .",
		"pack": "electron-builder --dir",
		"dist": "electron-builder",
		"postinstall": "electron-builder install-app-deps"
	},
	"author": "klikbase <connect@klikbase.com>",
	"license": "ISC",
	"description": "Klikbase Time Tracking Client",
	"dependencies": {
		"active-win": "^8.2.1",
		"electron-updater": "^6.8.9"
	},
	"devDependencies": {
		"electron": "^41.7.1",
		"electron-builder": "^24.13.3"
	},
	"build": {
		"appId": "com.factiiv.klikbase",
		"productName": "Klikbase Tracker",
		"publish": {
			"provider": "github",
			"owner": "mk-dev-07",
			"repo": "klikbase-desktop-app",
			"releaseType": "release"
		},
		"files": [
			"index.js",
			"preload.cjs",
			"updater.js",
			"package.json",
			"node_modules/**/*",
			"dist/**/*"
		],
		"directories": {
			"output": "release"
		},
		"win": {
			"target": [
				"nsis"
			],
			"icon": "build/icon.png"
		},
		"mac": {
			"target": [
				{
					"target": "dmg",
					"arch": [
						"x64",
						"arm64"
					]
				}
			],
			"extendInfo": {
				"NSScreenCaptureUsageDescription": "Klikbase needs screen recording permission to take screenshots of your active work.",
				"NSAccessibilityUsageDescription": "Klikbase needs accessibility access to detect the active application."
			},
			"category": "public.app-category.utilities",
			"icon": "build/icon.png",
			"hardenedRuntime": true,
			"notarize": {
				"teamId": "P3JV2APTCQ"
			},
			"entitlements": "entitlements.mac.plist",
			"entitlementsInherit": "entitlements.mac.plist"
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"icon": "build/icon.png"
		}
	}
}
